FROM haproxy:lts-alpine

USER root

RUN apk add --no-cache \
    curl \
    bash

COPY haproxy_healthcheck.sh /usr/local/etc/haproxy/haproxy_healthcheck.sh


RUN chown haproxy:haproxy /usr/local/etc/haproxy/haproxy_healthcheck.sh \
    && chmod 700 /usr/local/etc/haproxy/haproxy_healthcheck.sh

USER haproxy