FROM haproxy:lts-alpine

USER root

RUN apk add --no-cache \
    curl \
    bash

COPY healthcheck.sh /usr/local/etc/haproxy/healthcheck.sh


RUN chown haproxy:haproxy /usr/local/etc/haproxy/healthcheck.sh \
    && chmod 700 /usr/local/etc/haproxy/healthcheck.sh

USER haproxy

# in seconds
ENV MAX_LATENCY="1.0"
