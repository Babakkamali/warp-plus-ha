FROM haproxy:lts-alpine

USER root

RUN apk add --no-cache \
    curl \
    bash

COPY scripts/healthcheck.sh /usr/local/etc/haproxy/healthcheck.sh


RUN chown haproxy:haproxy /usr/local/etc/haproxy/healthcheck.sh \
    && chmod 700 /usr/local/etc/haproxy/healthcheck.sh

USER haproxy

# in seconds
ENV MAX_LATENCY="1.0"

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1
