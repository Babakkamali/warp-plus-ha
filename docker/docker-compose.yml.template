x-warp-plus-gool: &warp-plus-gool
  build: 
    context: .
    dockerfile: docker/Dockerfile.warp
  image: warp-plus:latest
  pull_policy: never
  labels:
    autoheal-app: true
  restart: always

x-warp-plus-psiphon: &warp-plus-psiphon
  <<: *warp-plus-gool
  environment:
    RUN_OPTIONS: "--cfon --scan --bind 0.0.0.0:8086"

services:
### gool services
{{GOOL_SERVICES}}
###

### psiphon services
{{PSIPHON_SERVICES}}
###

  haproxy:
    build:
      context: .
      dockerfile: docker/Dockerfile.haproxy
    image: haproxy-warp:latest
    pull_policy: never
    ports:
      - "1080:1080"
      - "1081:1081"
    volumes:
      - ./haproxy/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg
    depends_on:
{{HAPROXY_DEPENDENCIES}}
    labels:
      autoheal-app: true
    restart: always

  autoheal:
    environment:
      AUTOHEAL_CONTAINER_LABEL: autoheal-app
    image: willfarrell/autoheal:latest
    network_mode: none
    restart: always
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock
