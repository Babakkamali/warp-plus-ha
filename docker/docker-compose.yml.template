x-warp-plus-gool: &warp-plus-gool
  build: 
    context: .
    dockerfile: docker/Dockerfile.warp
  image: warp-plus:latest
  pull_policy: never
  labels:
    autoheal-app: ${GOOL_AUTOHEAL_APP}
  restart: always
  environment:
    RUN_OPTIONS: ${GOOL_RUN_OPTIONS}

x-warp-plus-psiphon: &warp-plus-psiphon
  <<: *warp-plus-gool
  environment:
    RUN_OPTIONS: ${PSIPHON_RUN_OPTIONS}
  labels:
    autoheal-app: ${PSIPHON_AUTOHEAL_APP}

x-xray-core: &xray-core
  image: ${BASE_IMAGE_XRAY}
  restart: always

services:
### gool services
{{GOOL_SERVICES}}
###

### psiphon services
{{PSIPHON_SERVICES}}
###

### xray services
{{XRAY_SERVICES}}
###

  haproxy:
    build:
      context: .
      dockerfile: docker/Dockerfile.haproxy
    image: haproxy-warp:latest
    pull_policy: never
  ### HAPROXY_PORTS ###
    volumes:
      - ./haproxy/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg
    depends_on:
{{HAPROXY_DEPENDENCIES}}
    labels:
      autoheal-app: ${HAPROXY_AUTOHEAL_APP}
    restart: always
  
  autoheal:
    environment:
      AUTOHEAL_CONTAINER_LABEL: autoheal-app
    image: ${IMAGE_AUTOHEAL}
    network_mode: none
    restart: always
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock
