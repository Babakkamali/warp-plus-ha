# Number of GOOL instances
NUM_GOOL=3

# Number of PSIPHON instances
NUM_PSIPHON=3

# Autoheal app label value (used for gool, psiphon and haproxy services)
GOOL_AUTOHEAL_APP=true
PSIPHON_AUTOHEAL_APP=true
HAPROXY_AUTOHEAL_APP=true

# RUN_OPTIONS for GOOL and PSIPHON services
PSIPHON_RUN_OPTIONS="--cfon --scan --bind 0.0.0.0:8086"
GOOL_RUN_OPTIONS="--gool --scan --bind 0.0.0.0:8086"

# HAPROXY ports (host side)
HAPROXY_SOCKS_PUBLISH=true
HAPROXY_GOOL_PORT=1080
HAPROXY_PSIPHON_PORT=1081

# Xray
XRAY_ENABLED=true

XRAY_GOOL_PORT=
XRAY_GOOL_UUID=
XRAY_GOOL_EMAIL=test@mail.com

XRAY_PSIPHON_PORT=
XRAY_PSIPHON_UUID=
XRAY_PSIPHON_EMAIL=test@mail.com

# Base Docker Images
IMAGE_AUTOHEAL=willfarrell/autoheal:latest
BASE_IMAGE_HAPROXY=haproxy:lts-alpine
BASE_IMAGE_WARP=alpine:latest
BASE_IMAGE_XRAY=teddysun/xray:latest
